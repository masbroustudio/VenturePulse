{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "QlooVenturePulseSkillSuite",
  "description": "JSON Schemas for Venture Pulse 8-Tool Protocol (Qloo 250M+ Taste Graph)",
  "skills": {
    "qloo_taste_explorer": {
      "type": "object",
      "required": ["anchorEntities", "targetDomains"],
      "properties": {
        "anchorEntities": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "maxItems": 8
        },
        "targetDomains": {
          "type": "array",
          "items": { "type": "string", "enum": ["fashion", "beverage", "tech", "living", "lifestyle", "apparel"] }
        },
        "excludedTags": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Anti-affinity guardrails to prevent brand clashes"
        },
        "minAffinityThreshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.5
        }
      }
    },
    "subcultural_audience_discovery": {
      "type": "object",
      "required": ["brandEntity", "targetCreatorCategories"],
      "properties": {
        "brandEntity": { "type": "string" },
        "targetCreatorCategories": {
          "type": "array",
          "items": { "type": "string", "enum": ["Gaming", "Podcast", "Art", "Music", "Tech"] }
        },
        "minAffinityMultiplier": {
          "type": "number",
          "default": 5.0
        }
      }
    },
    "market_feasibility_validator": {
      "type": "object",
      "required": ["brandName", "brandDomain", "creatorCategory", "creatorAudienceTier"],
      "properties": {
        "brandName": { "type": "string" },
        "brandDomain": { "type": "string" },
        "creatorCategory": { "type": "string" },
        "creatorAudienceTier": {
          "type": "string",
          "enum": ["Nano (1k-10k)", "Micro (10k-50k)", "Mid (50k-250k)", "Macro (250k+)", "Enterprise ($50k+)"]
        }
      }
    },
    "creative_concept_synthesizer": {
      "type": "object",
      "required": ["creatorName", "creatorVibe", "brandName", "brandDomain", "culturalIntersectionTags"],
      "properties": {
        "creatorName": { "type": "string" },
        "creatorVibe": { "type": "string" },
        "brandName": { "type": "string" },
        "brandDomain": { "type": "string" },
        "culturalIntersectionTags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "humanConstraints": {
          "type": "string",
          "description": "Optional human-in-the-loop founder constraint injected mid-debate"
        }
      }
    },
    "unit_economics_calculator": {
      "type": "object",
      "required": ["editionRunSize", "targetRetailPrice"],
      "properties": {
        "editionRunSize": { "type": "integer", "minimum": 50, "maximum": 10000 },
        "targetRetailPrice": { "type": "number", "minimum": 10 },
        "royaltySplitPct": { "type": "number", "minimum": 0.05, "maximum": 0.5, "default": 0.18 },
        "qlooAffinityMultiplier": { "type": "number", "default": 7.0 }
      }
    },
    "pitch_architect": {
      "type": "object",
      "required": ["targetBrand", "creatorName", "audienceSummary", "productConcept", "qlooAffinityMultiplier"],
      "properties": {
        "targetBrand": { "type": "string" },
        "creatorName": { "type": "string" },
        "audienceSummary": { "type": "string" },
        "productConcept": {
          "type": "object",
          "required": ["title", "description"],
          "properties": {
            "title": { "type": "string" },
            "description": { "type": "string" }
          }
        },
        "qlooAffinityMultiplier": { "type": "number" }
      }
    },
    "vanilla_llm_counter_proof": {
      "type": "object",
      "required": ["creatorName", "creatorCategory"],
      "properties": {
        "creatorName": { "type": "string" },
        "creatorCategory": { "type": "string" }
      }
    },
    "crm_webhook_dispatcher": {
      "type": "object",
      "required": ["targetService", "webhookUrl", "cardPayload"],
      "properties": {
        "targetService": {
          "type": "string",
          "enum": ["HubSpot", "Notion", "Custom_Webhook"]
        },
        "webhookUrl": { "type": "string", "format": "uri" },
        "cardPayload": { "type": "object" }
      }
    }
  }
}
