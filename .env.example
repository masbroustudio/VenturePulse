# ==========================================
# Venture Pulse - Environment Configuration Template
# (Do NOT commit actual API keys to GitHub)
# ==========================================

# Qloo Cultural AI API (Official Hackathon Gateway)
QLOO_API_KEY=your_qloo_api_key_here
QLOO_API_BASE_URL=https://hackathon.api.qloo.com

# LLM Provider Configuration ("groq", "gemini", or "openai")
LLM_PROVIDER=groq

# Groq API Key (High-Speed LLaMA 3.3 70B & Qwen 2.5 32B via LiteLLM)
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini API Key (Gemini 2.0 Flash / Gemini 1.5 Pro)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Optional fallback)
OPENAI_API_KEY=your_openai_key_here

# Backend Service Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
