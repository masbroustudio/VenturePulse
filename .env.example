# ==========================================
# Venture Pulse - Environment Configuration
# ==========================================

# Qloo Cultural AI API (Official Hackathon Gateway)
QLOO_API_KEY=your_qloo_api_key_here
QLOO_API_BASE_URL=https://hackathon.api.qloo.com

# LLM Provider Configuration ("google", "openai", "sumopod", or "custom")
AI_PROVIDER=google

# Google Gemini API Key (Gemini 2.0 Flash / Gemini 2.5 Pro)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI or SumoPod / Custom Endpoint (OpenAI-compatible)
OPENAI_API_KEY=your_openai_or_sumopod_api_key_here
OPENAI_BASE_URL=https://api.sumopod.com/v1

# Supabase (Managed PostgreSQL + pgvector)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# LangFuse Observability & Tracing (Optional / Recommended for Judges)
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# Outbound CRM Webhook Simulation
DEFAULT_WEBHOOK_URL=https://webhook.site/demo-crm
