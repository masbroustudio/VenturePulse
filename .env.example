# ==========================================
# Venture Pulse - Environment Configuration
# ==========================================

# Qloo Cultural AI API Key (from Qloo Hackathon developer guide)
QLOO_API_KEY=your_qloo_api_key_here
QLOO_API_BASE_URL=https://api.qloo.com

# LLM Provider Configuration
# Supported: "google", "openai", "sumopod", or "custom"
AI_PROVIDER=google

# Google Gemini API Key (if using AI_PROVIDER=google)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI or OpenAI-Compatible API Key (if using AI_PROVIDER=openai or sumopod)
OPENAI_API_KEY=your_openai_or_sumopod_api_key_here
# Optional Base URL for custom/OpenAI-compatible endpoints (e.g. SumoPod)
OPENAI_BASE_URL=https://api.sumopod.com/v1

# Optional webhook URL for external CRM simulation
DEFAULT_WEBHOOK_URL=https://webhook.site/demo-crm
